# AI Office - Environment Variables
# Copy this file to .env and fill in your actual values.

# OpenAI API Key (required for real AI responses)
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Optional: override the default model
# OPENAI_MODEL=gpt-4o
# OPENAI_IMAGE_MODEL=dall-e-3

# Second brain: per-role models (cheap for frequent calls, stronger for rare summaries)
# MODEL_CLASSIFIER=gpt-4o-mini
# MODEL_ARCHIVIST=gpt-4o-mini
# MODEL_MINUTES=gpt-4o
# MODEL_FINDER=gpt-4o
# MODEL_REPORTER=gpt-4o
# MODEL_COACH=gpt-4o
# MODEL_SCHEDULER=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# BRAIN_CATEGORIES=개발,운영/장애,회의,기획,팀관리,학습,커리어,기타

# Flask (debug mode exposes a remote-code-execution debugger; keep it off)
# Keep FLASK_HOST at 127.0.0.1: the app has no login, so 0.0.0.0 would open
# your records to everyone on the same network.
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Privacy: phone numbers, resident/card/plate numbers and e-mails are masked
# before anything is sent to OpenAI. Records on disk keep the original text.
# MASK_PERSONAL_DATA=true
# Extra regexes to mask, separated by || (e.g. your policy number format)
# MASK_EXTRA_PATTERNS=\b[A-Z]{2}\d{10}\b||\b\d{4}-\d{6}-\d{2}\b

# Daily copies of data/brain.db kept in data/backups/
# BACKUP_KEEP=14
